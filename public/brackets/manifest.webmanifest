{
	"name": "Brackets — Tournament Maker",
	"short_name": "Brackets",
	"description": "Create players, seed randomly, and run single or double elimination tournament brackets — fully offline.",
	"start_url": "./index.html",
	"scope": "./",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#0b0f1a",
	"theme_color": "#0b0f1a",
	"icons": [
		{
			"src": "icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icons/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	]
}
